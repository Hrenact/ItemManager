{
  "name": "item-manager",
  "version": "0.1.0",
  "private": true,
  "description": "A local dark-theme item library manager.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "clean:release": "powershell -NoProfile -Command \"Remove-Item -LiteralPath release -Recurse -Force -ErrorAction SilentlyContinue\"",
    "dist": "npm run clean:release && set \"ELECTRON_CACHE=%CD%\\.electron-cache\"&& set \"ELECTRON_BUILDER_CACHE=%CD%\\.electron-builder-cache\"&& electron-builder --win"
  },
  "keywords": [
    "item-manager",
    "library",
    "local"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hrenact.itemmanager",
    "productName": "Item Manager",
    "afterPack": "build/after-pack.js",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "public/**/*",
      "image/**/*",
      "server.js",
      "electron-main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        "dir",
        "zip"
      ],
      "icon": "build/icon.ico"
    }
  }
}
