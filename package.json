{
  "name": "item-manager",
  "version": "0.1.0",
  "private": true,
  "description": "A local dark-theme item library manager.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "set \"ELECTRON_CACHE=%CD%\\.electron-cache\"&& set \"ELECTRON_BUILDER_CACHE=%CD%\\.electron-builder-cache\"&& electron-builder --win"
  },
  "keywords": [
    "item-manager",
    "library",
    "local"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hrenact.itemmanager",
    "productName": "Item Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "public/**/*",
      "server.js",
      "electron-main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": "portable"
    }
  }
}
